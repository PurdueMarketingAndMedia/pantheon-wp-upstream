{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "purdue/content-block",
	"title": "Content Block",
	"category": "purdue",
	"description": "Content Block for adding content on the page.",
	"attributes": {
		"width": {
			"type": "string",
			"default": "narrow"
		},
		"addHeader": {
			"type": "boolean",
			"default": false
		},
		"header": {
			"type": "string",
			"default": ""
		},
		"headerColor":{
			"type": "string",
			"default": "gold"
		},
		"withSidebar": {
			"type": "boolean",
			"default": false
		},
		"sidebarLocationDesktop": {
			"type": "string",
			"default": "right"
		},
		"sidebarLocationMobile": {
			"type": "string",
			"default": "below"
		},
		"bgColor": {
			"type": "string",
			"default": ""
		},
		"paddingTop": {
			"type": "string",
			"default": ""
		},
		"paddingBottom": {
			"type": "string",
			"default": ""
		},
		"twoColumn": {
			"type": "boolean",
			"default": false
		},
		"border": {
			"type": "boolean",
			"default": false
		},
		"stackReverseMobile": {
			"type": "boolean",
			"default": false
		},
		"divider": {
			"type": "boolean",
			"default": false
		},
		"verticalCenter": {
			"type": "boolean",
			"default": false
		},
		"id": {
			"type": "string",
			"default": ""
		},
		"className": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "content-block",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
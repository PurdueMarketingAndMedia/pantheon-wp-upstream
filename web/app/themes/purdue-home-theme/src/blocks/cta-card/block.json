{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "purdue/cta-card",
	"version": "1.1.01",
	"title": "50/50 Slideshow CTA",
	"category": "purdue",
	"description": "This block adds a CTA block with path way options.",
	"supports": {
		"html": false
	},
    "attributes": {
		"background": {
			"type": "string",
			"default": "none"
		},
		"contentAlign": {
			"type": "string",
			"default": "right"
		},
		"subheader": {
			"type": "string",
			"default": ""
		},
		"header": {
			"type": "string",
			"default": ""
		},
		"imgs": {
			"type": "array",
			"default": []
		},
		"links": {
			"type": "array",
			"default": []
		},
		"paddingTop": {
			"type": "string",
			"default": ""
		},
		"paddingBottom": {
			"type": "string",
			"default": ""
		},
		"id": {
			"type": "string",
			"default": ""
		},
		"className": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "cta-card",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
	"render": "file:./render.php",
	"script": "file:./frontend.js"

}
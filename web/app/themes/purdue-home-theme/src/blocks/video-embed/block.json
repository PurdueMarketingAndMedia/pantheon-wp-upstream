{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "purdue/video-embed",
    "version": "1.1.01",
    "title": "Video Embed",
    "category": "purdue",
    "description": "Embed video",
    "supports": {
      "className": false
    },
    "attributes": {
        "background": {
          "type": "string",
          "default": "none"
        },
        "header": {
          "type": "string",
          "default": ""
        },
        "buttonText": {
          "type": "string",
          "default": "Watch Video"
        },
        "mediaType": {
          "type": "string",
          "default": "image"
        },
        "mediaURL": {
          "type": "string",
          "default": ""
        },
        "mediaAlt": {
          "type": "string",
          "default": ""
        },
        "mediaTitle": {
          "type": "string",
          "default": ""
        },
        "youtubeLink": {
          "type": "string",
          "default": ""
        },
        "paddingTop": {
          "type": "string",
          "default": ""
        },
        "paddingBottom": {
          "type": "string",
          "default": ""
        },
        "removeSidePadding": {
          "type": "boolean",
          "default": false
        },
        "id": {
          "type": "string",
          "default": ""
        },
        "className": {
          "type": "string",
          "default": ""
        },
        "aspectRatio": {
          "type": "string",
          "default": "is-16by9"
        }
    },
    "textdomain": "video-embed",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
}

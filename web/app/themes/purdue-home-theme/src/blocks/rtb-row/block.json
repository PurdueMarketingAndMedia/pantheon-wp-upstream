{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "purdue/rtb-row",
  "version": "1.1.02",
  "title": "Validation Boxes",
  "category": "purdue",
  "description": "This block adds rows of Validation Boxes.",
  "supports": {
    "html": false
  },
  "attributes": {
    "background": {
      "type": "string",
      "default": "none"
    },
    "layout": {
      "type": "string",
      "default": "horizontal"
    },
    "rtbs": {
      "type": "array",
      "default": []
    },
    "columns": {
      "type": "string",
      "default": "3"
    },
    "paddingTop": {
      "type": "string",
      "default": ""
    },
    "paddingBottom": {
      "type": "string",
      "default": ""
    },
    "id": {
      "type": "string",
      "default": ""
    },
    "className": {
      "type": "string",
      "default": ""
    },
    "blockId": {
      "type": "string",
      "default": ""
    },
    "type": {
      "type": "string",
      "default": "grid"
    },
    "loop": {
      "type": "boolean",
      "default": true
    }
  },
  "textdomain": "rtb-row",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./frontend.js"
}
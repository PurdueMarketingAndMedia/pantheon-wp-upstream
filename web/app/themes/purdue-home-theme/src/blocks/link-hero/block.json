{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "purdue/link-hero",
	"version": "1.1.01",
	"title": "Link Hero",
	"category": "purdue",
	"description": "This block adds a link hero block.",
	"supports": {
		"html": false
	},
    "attributes": {
		"header": {
			"type": "string",
			"default": ""
		},
		"subheader": {
			"type": "string",
			"default": ""
		},
		"subtext": {
			"type": "string",
			"default": ""
		},
		"descText": {
			"type": "string",
			"default": "Shortcuts"
		},
		"linkType": {
			"type": "string",
			"default": "shortCuts"
		},
		"mediaType": {
			"type": "string",
			"default": ""
		},
		"mediaURL": {
			"type": "string",
			"default": ""
		},
		"mediaAlt": {
			"type": "string",
			"default": ""
		},
		"mediaTitle": {
			"type": "string",
			"default": ""
		},
		"links": {
			"type": "array",
			"default": []
		},
		"ctalinks": {
			"type": "array",
			"default": []
		},
		"id": {
			"type": "string",
			"default": ""
		},
		"fieldId": {
			"type": "string",
			"default": ""
		},
		"className": {
			"type": "string",
			"default": ""
		},
		"buttonCSS": {
			"type": "string",
			"default": ""
		},
		"background": {
			"type": "string",
			"default": "image-background"
		}
	},
	"textdomain": "link-hero",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./frontend.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}


{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "purdue/rtb-hero",
    "version": "1.1.01",
    "title": "Site Hero",
    "category": "purdue",
    "description": "This block adds a hero block",
    "supports": {
      "html": false
    },
    "attributes": {
      "type": {
        "type": "string",
        "default": "slider"
      },
      "header": {
        "type": "string",
        "default": ""
      },
      "subheader": {
        "type": "string",
        "default": ""
      },
      "subtext": {
        "type": "string",
        "default": ""
      },
      "mediaType": {
        "type": "string",
        "default": ""
      },
      "mediaURL": {
        "type": "string",
        "default": ""
      },
      "mediaAlt": {
        "type": "string",
        "default": ""
      },
      "mediaTitle": {
        "type": "string",
        "default": ""
      },
      "sliderCards": {
        "type": "array",
        "default": []
      },
      "links": {
        "type": "array",
        "default": []
      },
      "id": {
        "type": "string",
        "default": ""
      },
      "className": {
        "type": "string",
        "default": ""
      }
    },
    "textdomain": "rtb-hero",
    "editorScript": "file:./index.js",
    "viewScript": ["file:./frontend.js"],
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
  }
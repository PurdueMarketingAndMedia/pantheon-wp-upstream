{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "purdue/flipping-cards",
	"version": "1.1.01",
	"title": "Flipping Cards",
	"category": "purdue",
	"description": "This block adds a flipping cards grid.",
	"supports": {
		"html": false
	},
    "attributes": {
		"background": {
			"type": "string",
			"default": "none"
		},
		"header": {
			"type": "string",
			"default": ""
		},
		"content": {
			"type": "string",
			"default": ""
		},
		"cards": {
			"type": "array",
			"default": []
		},
		"paddingTop": {
			"type": "string",
			"default": ""
		},
		"paddingBottom": {
			"type": "string",
			"default": ""
		},
		"removeSidePadding": {
            "type": "boolean",
            "default": false
        },
		"columns": {
			"type": "string",
			"default": "2"
		},
		"id": {
			"type": "string",
			"default": ""
		},
		"className": {
			"type": "string",
			"default": ""
		}
	},
	"script": "file:./frontend.js",
	"textdomain": "flipping-cards",
	"editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "purdue/cta-strap",
	"version": "1.1.01",
	"title": "CTA Mini Banner",
	"category": "purdue",
	"description": "This block adds a CTA Mini Banner.",
	"supports": {
		"html": false
	},
	"attributes": {
		"type": {
			"type": "string",
			"default": "regular"
		},
		"subHeader": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"background": {
			"type": "string",
			"default": "black"
		},
		"outerBackground": {
			"type": "string",
			"default": "black"
		},
		"buttons": {
			"type": "array",
			"default": []
		},
		"stackButton": {
			"type": "boolean",
			"default": false
		},
		"id": {
			"type": "string",
			"default": ""
		},
		"className": {
			"type": "string",
			"default": ""
		},
		"mediaType": {
            "type": "string",
            "default": ""
        },
        "mediaURL": {
            "type": "string",
            "default": ""
        },
        "mediaAlt": {
            "type": "string",
            "default": ""
        },
        "mediaTitle": {
            "type": "string",
            "default": ""
        },
		"buttonCSS": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "cta-strap",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
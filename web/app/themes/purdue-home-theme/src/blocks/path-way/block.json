{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "purdue/path-way",
    "version": "1.1.01",
    "title": "Path way",
    "category": "purdue",
    "description": "This block adds a path way block",
    "supports": {
      "html": false
    },
    "attributes": {
		"type": {
			"type": "string",
			"default": "aligned"
		},
		"isFirst": {
			"type": "boolean",
			"default": false
		},
		"isLast": {
			"type": "boolean",
			"default": false
		},
		"imageSize": {
			"type": "string",
			"default": "horizontal"
		},
		"header": {
			"type": "string",
			"default": ""
		},
		"headerLevel": {
			"type": "string",
			"default": "h2"
		},
		"contentAlign": {
			"type": "string",
			"default": "right"
		},
		"subheader": {
			"type": "string",
			"default": ""
		},
		"descText": {
			"type": "string",
			"default": ""
		},
		"mediaURL": {
			"type": "string",
			"default": ""
		},
		"mediaAlt": {
			"type": "string",
			"default": ""
		},
		"linkDisplay": {
			"type": "string",
			"default": "buttons"
		},
		"links": {
			"type": "array",
			"default": []
		},
		"addConnector": {
			"type": "boolean",
			"default": true
		},
		"connectorType": {
			"type": "string",
			"default": "straight"
		},
		"fieldId": {
			"type": "string",
			"default": ""
		},
		"id": {
			"type": "string",
			"default": ""
		},
		"className": {
			"type": "string",
			"default": ""
		},
		"buttonCSS": {
			"type": "string",
			"default": ""
		}, 
		"linkCSS": {
			"type": "string",
			"default": ""
		}
	},
    "textdomain": "path-way",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "viewScript": "file:./frontend.js",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
  }
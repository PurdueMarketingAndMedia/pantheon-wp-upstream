{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "purdue/cta-grid",
	"version": "1.1.01",
	"title": "CTA Grid",
	"category": "purdue",
	"description": "This block adds a grid of CTA cards.",
	"supports": {
		"html": false
	},
	"attributes": {
		"background": {
			"type": "string",
			"default": "none"
		},
		"hasIntro": {
			"type": "boolean",
			"default": true
		},
		"hasDecoration": {
			"type": "boolean",
			"default": false
		},
		"header": {
			"type": "string",
			"default": ""
		},
		"cards": {
			"type": "array",
			"default": []
		},
		"alignment": {
			"type": "string",
			"default": ""
		},
		"paddingTop": {
			"type": "string",
			"default": ""
		},
		"paddingBottom": {
			"type": "string",
			"default": ""
		},
		"columns": {
			"type": "string",
			"default": "4"
		},
		"id": {
			"type": "string",
			"default": ""
		},
		"className": {
			"type": "string",
			"default": ""
		},
		"buttonCSS": {
            "type":  "string",
            "default": ""
        }
	},
	"textdomain": "cta-grid",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}